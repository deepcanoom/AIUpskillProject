# Copy this file to `.env` and fill in your API key.
# `.env` is gitignored - never commit it.
#
# NEVER put a real key in this file. `.env.example` IS tracked by git,
# so any key written here is published. Use placeholders only.
# -----------------------------------------------------------------------------
# Default model the curriculum points at.
#
# This uses LiteLLM's model-string format. To swap providers, change this line
# AND uncomment the matching key below. See https://docs.litellm.ai/docs/providers
# for the full list of supported model strings.
# -----------------------------------------------------------------------------
# Pick ONE LITELLM_MODEL line and ONE matching key.
LITELLM_MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=your-gemini-key-here
# Alternative: Groq
# LITELLM_MODEL=groq/openai/gpt-oss-120b
# GROQ_API_KEY=your-groq-key-here
# Alternative: Anthropic
# LITELLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# -----------------------------------------------------------------------------
# General config
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
